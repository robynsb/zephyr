#include <dt-bindings/pinctrl/rpi-pico-rp2350a-pinctrl.h>
#include <zephyr/dt-bindings/dma/rpi-pico-dma-rp2350.h>

/ {
	aliases {
		i2s-node0 = &pio1_i2s0;
	};
};

&pinctrl {
	pio1_i2s: pio1_i2s {
		tx_data: tx_data {
			pinmux = <PIO1_P28>;
		};
		rx_data: rx_data {
			pinmux = <PIO1_P22>;
			/* Enable the pad input buffer so the PIO `in pins` can sample
			 * the RX data line (off by default).
			 */
			input-enable;
		};
		clks: clks {
			/*        CLK BASE  (WS = CLK+1) -> BCLK, LRCLK side-set */
			pinmux = <PIO1_P26 PIO1_P27>;
		};
	};
};

&pio1 {
	status = "okay";

	pio1_i2s0: i2s0 {
		compatible = "raspberrypi,pico-i2s-pio";
		status = "okay";

		pinctrl-0 = <&pio1_i2s>;
		pinctrl-names = "default";

		#address-cells = <1>;
		#size-cells = <0>;

		dmas = <&dma 7 RPI_PICO_DMA_SLOT_PIO1_TX0 0>,
		       <&dma 8 RPI_PICO_DMA_SLOT_PIO1_RX0 0>;
		dma-names = "tx", "rx";
	};
};

&dma {
	status = "okay";
};
