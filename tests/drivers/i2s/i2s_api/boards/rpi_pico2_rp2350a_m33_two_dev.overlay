/*
 * Two-device GPIO-loopback variant: exercises the PIO I2S driver in target mode.
 *
 *   i2s-node1 = pio1 -> TX, clock CONTROLLER (drives BCLK/WS)
 *   i2s-node0 = pio0 -> RX, clock TARGET     (recovers BCLK/WS from the pins)
 *
 * configure_stream() in src/common.c assigns those roles; main.c only ever
 * configures node0 for RX and node1 for TX. Both nodes still name a "tx" and an
 * "rx" DMA channel, though, so the driver enables both directions on both
 * instances -- the unused direction on each is simply never configured.
 *
 * Required jumpers:
 *
 *   GP12 (node1 tx_data) <---> GP8 (node0 rx_data)
 *   GP11 (node1 clks)    <---> GP9 (node0 clks)
 *   GP13 (node1 ws)      <---> GP7 (node0 ws)
 *
 * Pin-assignment constraint (driver, not arbitrary): the rx_target program does
 * `in pins, 1` at in_base+0 and `wait n pin, 1` at in_base+1, with in_base set
 * from rx_data (i2s_rpi_pico_pio.c:444-445). So clks must be rx_data + 1, and
 * the driver asserts it at build time for every instance whose "rx" DMA channel
 * is named -- hence 8/9 on pio0 and 10/11 on pio1. That assert is why pio1's
 * rx_data is repointed below even though this test never receives on pio1: the
 * base overlay parks rx_data on tx_data's pin for its single-device internal
 * loopback, which is nowhere near the clks pin used here. The TX side has no
 * such adjacency requirement.
 *
 * This overlay is layered on top of boards/rpi_pico2_rp2350a_m33.overlay, which
 * twister applies automatically for this board target. It repoints the existing
 * pio1 pinctrl groups rather than redefining them; all four have to move, since
 * the base overlay's tx_data/rx_data share a pin and pio1 now needs four
 * distinct ones.
 */

#include <dt-bindings/pinctrl/rpi-pico-rp2350a-pinctrl.h>
#include <zephyr/dt-bindings/dma/rpi-pico-dma-rp2350.h>

/ {
	aliases {
		/* Overrides the base overlay's i2s-node0 = &pio1_i2s0. */
		i2s-node0 = &pio0_i2s0;
		i2s-node1 = &pio1_i2s0;
	};
};


&rx_data {
	pinmux = <PIO1_P10>;
};

&clks {
	pinmux = <PIO1_P11>;
};

&tx_data {
	pinmux = <PIO1_P12>;
};

&ws {
	pinmux = <PIO1_P13>;
};


&pinctrl {
	pio0_i2s: pio0_i2s {
		pio0_tx_data: tx_data {
			pinmux = <PIO0_P6>;
		};

		pio0_ws: ws {
			pinmux = <PIO0_P7>;
			input-enable;
		};

		pio0_rx_data: rx_data {
			pinmux = <PIO0_P8>;
			input-enable;
		};
		pio0_clks: clks {
			pinmux = <PIO0_P9>;
			input-enable;
		};
	};
};

&pio0 {
	status = "okay";

	pio0_i2s0: i2s0 {
		compatible = "raspberrypi,pico-i2s-pio";
		status = "okay";

		pinctrl-0 = <&pio0_i2s>;
		pinctrl-names = "default";

		#address-cells = <1>;
		#size-cells = <0>;

		/* Channels 7/8 are taken by pio1_i2s0 in the base overlay. */
		dmas = <&dma 5 0 0>,
		       <&dma 6 0 0>;
		dma-names = "tx", "rx";
	};
};
