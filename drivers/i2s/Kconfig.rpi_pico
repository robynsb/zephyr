# STM32 I2S driver configuration options

# Copyright (c) 2018 STMicroelectronics
# SPDX-License-Identifier: Apache-2.0

config I2S_RPI_PICO_PIO
	bool "Raspberry Pi Pico PIO I2S controller driver"
	default y
	# depends on DT_HAS_RASPBERRYPI_PICO_SPI_PIO_ENABLED # TODO: do this for device tree I2S
	select PICOSDK_USE_PIO
	select PICOSDK_USE_CLAIM
	select PINCTRL
	help
	  Enable driving I2S via PIO on the Raspberry Pi Pico


if I2S_RPI_PICO_PIO

config I2S_RPI_PICO_PIO_RX_QUEUE_SIZE
	int "RX queue length"
	default 32
	help
	  This option sets the number of elements allocated for the rx software
	  queue. This should match the number of blocks in the memory slab
	  that will hold the i2s receive data.

config I2S_RPI_PICO_PIO_TX_QUEUE_SIZE
	int "TX queue length"
	default 32
	help
	  This option sets the number of elements allocated for the tx software
	  queue. This should match the number of blocks in the memory slab
	  that will hold the i2s transmit data.

endif # I2S_RPI_PICO_PIO
